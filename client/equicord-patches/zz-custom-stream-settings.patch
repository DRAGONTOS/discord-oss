+type CustomStreamSettings = Record<"bitrate" | "resolution" | "framerate", number | string>;
+
+type CustomQuality = {
+    bitrate: number;
+    height: number;
+    width: number;
+    framerate: number;
+    source: boolean;
+};
+
+function getCustomSettingsStore(): CustomStreamSettings | undefined {
+    return window.Vencord?.Plugins?.plugins?.FosscordGoLive?.settings?.store as CustomStreamSettings | undefined;
+}
+
+function getCustomQuality(): CustomQuality {
+    const store = getCustomSettingsStore();
+    const bitrate = typeof store?.bitrate === "number" ? store.bitrate : 0;
+    const resolution = store?.resolution;
+    const height = typeof resolution === "number" && resolution > 0 ? resolution : 0;
+    const framerate = typeof store?.framerate === "number" ? store.framerate : 0;
+    return {
+        bitrate,
+        height,
+        width: height ? Math.round((height / 9) * 16) : 0,
+        framerate: framerate > 0 ? framerate : 0,
+        source: resolution === 0,
+    };
+}
+
+function CustomSettingSelect({ label, options, settingsKey }: {
+    label: string;
+    options: Array<{ label: string; value: number | string }>;
+    settingsKey: keyof CustomStreamSettings;
+}) {
+    const store = getCustomSettingsStore();
+    const [value, setValue] = React.useState(() => store?.[settingsKey] ?? 0);
+
+    return (
+        <section className={cl("quality-section")}>
+            <Heading tag="h4">{label}</Heading>
+            <Select
+                options={options}
+                isSelected={option => option === value}
+                select={option => {
+                    setValue(option);
+                    if (store) store[settingsKey] = option;
+                }}
+                serialize={String}
+                closeOnSelect={true}
+            />
+        </section>
+    );
+}
